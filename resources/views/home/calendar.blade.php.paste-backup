@php
    $isBs = $type === 'bs';
    $isNs = $type === 'ns';

    $bsMonthsNe = ['बैशाख', 'जेठ', 'असार', 'साउन', 'भदौ', 'असोज', 'कार्तिक', 'मंसिर', 'पुष', 'माघ', 'फागुन', 'चैत'];
    $bsMonthsEn = ['Baisakh', 'Jestha', 'Ashadh', 'Shrawan', 'Bhadra', 'Ashwin', 'Kartik', 'Mangsir', 'Poush', 'Magh', 'Falgun', 'Chaitra'];
    $adMonthsEn = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    $adMonthsNe = ['जनवरी', 'फेब्रुअरी', 'मार्च', 'अप्रिल', 'मे', 'जुन', 'जुलाई', 'अगस्ट', 'सेप्टेम्बर', 'अक्टोबर', 'नोभेम्बर', 'डिसेम्बर'];

    $weekdaysEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    $weekdaysNe = ['आइत', 'सोम', 'मङ्गल', 'बुध', 'बिहि', 'शुक्र', 'शनि'];

    $monthName = $isBs
        ? ($languageId === 1 ? $bsMonthsNe[$calendarData['month'] - 1] : $bsMonthsEn[$calendarData['month'] - 1])
        : ($languageId === 1 ? $adMonthsNe[$calendarData['month'] - 1] : $adMonthsEn[$calendarData['month'] - 1]);

    $displayYear = $languageId === 1
        ? strtr((string) $calendarData['year'], ['0'=>'०','1'=>'१','2'=>'२','3'=>'३','4'=>'४','5'=>'५','6'=>'६','7'=>'७','8'=>'८','9'=>'९'])
        : $calendarData['year'];

    $previous = \Carbon\Carbon::create($calendarData['year'], $calendarData['month'], 1)->subMonth();
    $next = \Carbon\Carbon::create($calendarData['year'], $calendarData['month'], 1)->addMonth();
    $canPrevious = $type === 'ad' || $previous->year >= 2000;
    $canNext = $type === 'ad' || $next->year <= 2089;
@endphp

<div class="container">
    <div class="dor-calendar">
        <h2>{{ $calendarTitle }}</h2>

        <div class="dor-calendar-types">
            <a href="{{ route('frontend.calendar', ['subdomain' => $subdomain, 'type' => 'bs']) }}" class="{{ $type === 'bs' ? 'active' : '' }}">{{ $languageId === 1 ? 'विक्रम संवत्' : 'Bikram Sambat' }}</a>
            <a href="{{ route('frontend.calendar', ['subdomain' => $subdomain, 'type' => 'ad']) }}" class="{{ $type === 'ad' ? 'active' : '' }}">{{ $languageId === 1 ? 'ईस्वी संवत्' : 'Gregorian' }}</a>
            <a href="{{ route('frontend.calendar', ['subdomain' => $subdomain, 'type' => 'ns']) }}" class="{{ $type === 'ns' ? 'active' : '' }}">{{ $languageId === 1 ? 'नेपाल संवत्' : 'Nepal Sambat' }}</a>
        </div>

        @if($calendarUnavailable)
            <div class="dor-calendar-message">
                {{ $languageId === 1
                    ? 'नेपाल संवत् पात्रोको प्रमाणित मिति विवरण हाल उपलब्ध छैन। सही मिति सुनिश्चित भएपछि पात्रो देखाइनेछ।'
                    : 'Verified Nepal Sambat calendar data is not currently available. The calendar will be displayed when accurate date data is available.' }}
            </div>
        @else
            <div class="dor-calendar-nav">
                @if($canPrevious)
                    <a href="{{ route('frontend.calendar', ['subdomain' => $subdomain, 'type' => $type]) }}?year={{ $previous->year }}&month={{ $previous->month }}">&#8592; {{ $languageId === 1 ? 'अघिल्लो' : 'Previous' }}</a>
                @else
                    <span></span>
                @endif

                <strong>{{ $monthName }} {{ $displayYear }}</strong>

                @if($canNext)
                    <a href="{{ route('frontend.calendar', ['subdomain' => $subdomain, 'type' => $type]) }}?year={{ $next->year }}&month={{ $next->month }}">{{ $languageId === 1 ? 'अर्को' : 'Next' }} &#8594;</a>
                @else
                    <span></span>
                @endif
            </div>

            <div class="dor-calendar-grid">
                @foreach(($languageId === 1 ? $weekdaysNe : $weekdaysEn) as $weekday)
                    <div class="weekday">{{ $weekday }}</div>
                @endforeach

                @for($blank = 0; $blank < $calendarData['firstWeekday']; $blank++)
                    <div class="dor-calendar-empty"></div>
                @endfor

                @foreach($calendarData['days'] as $day)
                    <div class="{{ $day['isToday'] ? 'today' : '' }}">
                        {{ $isBs && $languageId === 1
                            ? $day['bsDate']
                            : ($languageId === 1
                                ? strtr((string) $day['day'], ['0'=>'०','1'=>'१','2'=>'२','3'=>'३','4'=>'४','5'=>'५','6'=>'६','7'=>'७','8'=>'८','9'=>'९'])
                                : $day['day']) }}
                    </div>
                @endforeach
            </div>
        @endif
    </div>
</div>
@endsection
